{
  "name": "newagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node bin/newagent.mjs",
    "build": "tsc && tsc -p tsconfig.web.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.web.json",
    "test": "tsx --test tests/*.test.ts",
    "start": "node bin/newagent.mjs",
    "setup": "tsx src/eval/setup.ts && tsx src/eval/setup-eval.ts",
    "eval:workflow": "tsx src/eval/evaluate.ts workflow",
    "eval:direct": "tsx src/eval/evaluate.ts direct",
    "test:fixtures": "tsx src/eval/validate-fixtures.ts",
    "start:web": "node dist/app-server/server.js",
    "eval:real:setup": "node scripts/eval/setup-real-eval.mjs",
    "eval:real:run": "node scripts/eval/run-real-eval.mjs",
    "eval:real:audit": "node scripts/eval/audit-real-eval.mjs",
    "eval:real:report": "node scripts/eval/report-real-eval.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:sandbox:real": "tsx scripts/sandbox-smoke.ts",
    "sandbox:dependencies": "tsx scripts/prepare-sandbox-dependencies.ts",
    "test:sandbox:workflow": "tsx scripts/sandbox-workflow-smoke.ts",
    "test:retrieval:real": "tsx scripts/qdrant-smoke.ts",
    "eval:upgrade:plan": "tsx src/eval/upgrade-plan.ts",
    "eval:local:setup": "tsx src/eval/setup-repository-eval.ts",
    "eval:local:calibrate": "tsx src/eval/run-repository-eval.ts calibration",
    "eval:local:run": "tsx src/eval/run-repository-eval.ts formal",
    "eval:local:retrieval": "tsx src/eval/evaluate-retrieval.ts",
    "eval:local:review": "tsx src/eval/evaluate-review.ts",
    "eval:local:download": "node --use-env-proxy scripts/download-eval-repositories.mjs",
    "eval:local:report": "node scripts/report-local-eval.mjs",
    "eval:local:diagnose": "tsx src/eval/run-repository-eval.ts diagnostic",
    "eval:local:sampling-diagnostic": "tsx src/eval/run-repository-eval.ts sampling-diagnostic",
    "eval:local:context-diagnostic": "tsx src/eval/run-repository-eval.ts context-diagnostic",
    "eval:local:rag-diagnostic": "tsx src/eval/run-repository-eval.ts rag-diagnostic",
    "eval:local:window-diagnostic": "tsx src/eval/run-repository-eval.ts window-diagnostic",
    "eval:local:single-case": "tsx src/eval/run-repository-eval.ts single-case-diagnostic",
    "eval:local:single-case-holdout": "tsx src/eval/run-repository-eval.ts single-case-holdout-diagnostic",
    "eval:local:reflexion-smoke": "tsx src/eval/reflexion-smoke.ts",
    "eval:ragas:export": "node scripts/ragas/export.mjs",
    "eval:ragas:run": "node scripts/ragas/cli.mjs run",
    "eval:ragas:report": "node scripts/ragas/cli.mjs report",
    "test:ragas": "node scripts/ragas/cli.mjs test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@fastify/static": "10.1.5",
    "@modelcontextprotocol/sdk": "1.31.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.27",
    "typescript-ast": "npm:typescript@5.9.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "bin": {
    "newagent": "bin/newagent.mjs"
  }
}
